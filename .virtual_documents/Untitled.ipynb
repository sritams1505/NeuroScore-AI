        rf_tuned_mae_training
    ],

    'Test RMSE': [
        lr_rmse_testing,
        rf_rmse_testing,
        rf_tuned_rmse_testing
    ],

    'Train RMSE': [
        lr_rmse_training,
        rf_rmse_training,
        rf_tuned_rmse_training
    ]
})

results = results.round(4)

results


