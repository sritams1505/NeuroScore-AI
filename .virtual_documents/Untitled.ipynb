        xgb_mae_training,
        lgbm_mae_training,
        cat_mae_training
    ],

    "Test RMSE": [
        lr_rmse_testing,
        dt_rmse_testing,
        rf_rmse_testing,
        np.sqrt(mean_squared_error(y_test, rf_preds_test_best)),
        et_rmse_testing,
        np.sqrt(mean_squared_error(y_test, et_preds_test_best)),
        gbr_rmse_testing,
        xgb_rmse_testing,
        lgbm_rmse_testing,
        cat_rmse_testing
    ],

    "Train RMSE": [
        lr_rmse_training,
        dt_rmse_training,
        rf_rmse_training,
        np.sqrt(mean_squared_error(y_train, rf_preds_train_best)),
        et_rmse_training,
        np.sqrt(mean_squared_error(y_train, et_preds_train_best)),
        gbr_rmse_training,
        xgb_rmse_training,
        lgbm_rmse_training,
        cat_rmse_training
    ]
})

results = (
    results
    .sort_values(by="Test R²", ascending=False)
    .reset_index(drop=True)
    .round(16)
)

results


